{
  "name": "personal-world-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json && cp -R migrations/. dist/migrations",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "test:signals": "tsx --test test/signals.test.ts",
    "db:dev": "docker compose up -d --wait postgres",
    "db:test": "docker compose --profile test up -d --wait postgres-test"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
