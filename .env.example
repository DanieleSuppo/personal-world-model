# Local development only. Never use these database credentials in production.
DATABASE_URL=postgres://pwm:local-development-only@127.0.0.1:55431/pwm
PWM_PRINCIPALS_FILE=.local/principals.json
PORT=3000

# Optional explicit processor opt-in; no default endpoint/model or fallback.
# Set BOTH only after checking the chosen processor's no-training/retention terms.
# Base is the API prefix, not the chat/completions endpoint. Local example:
# PWM_PROCESSOR_BASE_URL=http://127.0.0.1:8000/v1
# PWM_PROCESSOR_MODEL=your-explicit-model
# PWM_PROCESSOR_API_KEY=your-secret-if-required
# Without configuration, intake retains content and learning reports deferred.
